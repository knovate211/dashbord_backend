# ==========================================================================
# Environment variables required by dashbord_backend in production.
# Copy this file to .env and fill in real values — NEVER commit .env
# ==========================================================================

# ── Database (Amazon RDS PostgreSQL) ──────────────────────────────────────
POSTGRES_DSN=postgres://skillofide:<YOUR_DB_PASSWORD>@skillofide-db.czisgkemmwll.ap-south-1.rds.amazonaws.com:5432/skillofide?sslmode=require
DB_USER=skillofide
DB_PASSWORD=<YOUR_DB_PASSWORD>
DB_NAME=skillofide

# ── Redis (Amazon ElastiCache or self-hosted) ─────────────────────────────
REDIS_ADDR=<REDIS_HOST>:6379
REDIS_PASSWORD=<redis-password>

# ── NATS Messaging ────────────────────────────────────────────────────────
NATS_URL=nats://<NATS_HOST>:4222

# ── API Gateway ───────────────────────────────────────────────────────────
JWT_SECRET=<256-bit-random-secret>
# Comma-separated list of allowed frontend origins. Must include the marketing
# site's origin as well as the app's — the enquiry form and the scholarship
# application both post to the gateway from there.
ALLOWED_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com

# ── Scholarship funnel ────────────────────────────────────────────────────
# The test portal's public origin. A scholarship applicant's claim link is built
# from this, so a wrong value sends every applicant to a dead URL.
APP_BASE_URL=https://app.yourdomain.com
# Staff alerts for new scholarship applications; falls back to
# INQUIRY_NOTIFY_TO when unset. Candidate emails go out whenever SMTP_HOST is
# configured, regardless of this setting.
SCHOLARSHIP_NOTIFY_TO=admissions@yourdomain.com
# Public endpoint rate limits. The per-IP cap is a flood stop and has to fit a
# whole lab applying from one NAT address — a 50-candidate burst loses people at
# the contact-form default of 30. The per-email cap is the real abuse control.
SCHOLARSHIP_IP_LIMIT=200
SCHOLARSHIP_IP_WINDOW_MIN=10
SCHOLARSHIP_EMAIL_LIMIT=5
# How often lapsed, never-used scholarship links are retired, in minutes.
SCHOLARSHIP_SWEEP_MIN=15

# ── Judge (execution-service) ─────────────────────────────────────────────
# Allowance added to every time limit for container start and interpreter boot,
# which the judge's clock would otherwise charge to the candidate's code.
EXEC_STARTUP_GRACE_MS=3000
# How many sandboxed runs execute at once. Each is pinned to one CPU, so
# oversubscribing does not add throughput — past the cliff every run blows its
# time limit and correct code is marked wrong. Blank = CPUs/2.
EXEC_MAX_CONCURRENT=

# ── Job search (Placement section) ────────────────────────────────────────
# RapidAPI key for JSearch: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Subscribe to the API (the Basic tier is free) and paste the key here.
JSEARCH_API_KEY=<your-rapidapi-key>

# Gemini key for the AI mentor chat on course pages: https://aistudio.google.com/apikey
# Server-side only — never put it in the frontend. GEMINI_MODEL defaults to gemini-3.5-flash.
GEMINI_API_KEY=<your-gemini-key>
GEMINI_MODEL=

# ── AWS (for CI/CD GitHub Actions) ───────────────────────────────────────
AWS_ACCOUNT_ID=<your-aws-account-id>
AWS_REGION=ap-south-1
ECR_REGISTRY=<account-id>.dkr.ecr.ap-south-1.amazonaws.com
